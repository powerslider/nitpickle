# Per-developer working state (telemetry and deferred findings)
.nitpickle/validation-log.md
.nitpickle/todo.md

# Local review packets and audit roadmaps (transient, embed proof evidence)
docs/reviews/
docs/audits/

# Python test artifacts
__pycache__/
*.pyc

# ui-proof fixture app (Node deps and Playwright run artifacts)
# package-lock.json is committed so CI can npm ci reproducibly.
tests/fixtures/ui-proof-app/node_modules/
tests/fixtures/ui-proof-app/test-results/
tests/fixtures/ui-proof-app/playwright-report/
tests/fixtures/ui-proof-app/blob-report/
tests/fixtures/ui-proof-app/.playwright/
# Stray Playwright output if a run is launched from another cwd
test-results/

# Generated Codex install layout (generate on demand, never committed).
# The committed exception is the marketplace distribution bundle under
# .agents/plugins/, which a remote `codex plugin add` reads from git (ADR-0010).
.agents/*
!.agents/plugins/
.codex/
